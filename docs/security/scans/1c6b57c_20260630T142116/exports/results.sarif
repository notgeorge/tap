          "message": {
            "text": "The generic /panel/<slug>--<uuid>/ route resolves a Panel and renders its template without a grid.read authorization decision. A capless authenticated user received 200 over the Docker-published HTTP port, and a ViewerPanel instance could be pointed at another entity by query string to reveal fields that /object/... correctly denied."
          },
          "partialFingerprints": {
