{
  "feature": "Hub-and-spoke dispatch returns a hub and its one-hop neighborhood",
  "background": {
    "grift_fixture": "fixtures/sparse_dense.grift.json"
  },
  "scenarios": [
    {
      "name": "one-hop undirected neighborhood of the dense hub",
      "tags": ["hub-and-spoke", "dispatch", "current-behavior"],
      "covers": [
        "req-grid-traversal-lang-shape",
        "req-grid-traversal-lang-patterns",
        "req-grid-traversal-lang-params",
        "req-grid-traversal-exec-pipeline"
      ],
      "layer": "lite",
      "query": "MATCH (h)-[e]-(n) WHERE h.entity_id = $hub_id",
      "params": {
        "hub_id": "019e4b02-f37b-72df-a3e5-baf99158bb0c"
      },
      "expected_envelope": "expected/hub_and_spoke__dense_hub.expected.json",
      "expected_sql_snapshot": "expected/hub_and_spoke__dense_hub.sql.txt"
    },
    {
      "name": "inbound-only neighborhood of a hub with no inbound edges",
      "tags": ["hub-and-spoke", "direction", "current-behavior"],
      "covers": ["req-grid-traversal-lang-patterns"],
      "layer": "lite",
      "query": "MATCH (h)<-[e]-(n) WHERE h.entity_id = $hub_id",
      "params": {
        "hub_id": "019e4b02-f37b-72df-a3e5-baf99158bb0c"
      },
      "expected_envelope": "expected/hub_and_spoke__inbound_empty.expected.json",
      "expected_sql_snapshot": "expected/hub_and_spoke__inbound_empty.sql.txt"
    },
    {
      "name": "undirected neighborhood anchored on a leaf node",
      "tags": ["hub-and-spoke", "current-behavior"],
      "covers": [
        "req-grid-traversal-lang-patterns",
        "req-grid-traversal-lang-params"
      ],
      "layer": "lite",
      "query": "MATCH (x)-[e]-(y) WHERE x.entity_id = $node_id",
      "params": {
        "node_id": "019e4b02-f37b-72df-a3e5-bafa7b3865a9"
      },
      "expected_envelope": "expected/hub_and_spoke__leaf_anchor.expected.json",
      "expected_sql_snapshot": "expected/hub_and_spoke__leaf_anchor.sql.txt"
    },
    {
      "name": "anchor entity not found yields an empty envelope with a warning",
      "tags": ["hub-and-spoke", "corner", "current-behavior"],
      "covers": ["req-grid-traversal-exec-pipeline"],
      "layer": "lite",
      "query": "MATCH (h)-[e]-(n) WHERE h.entity_id = $missing_id",
      "params": {
        "missing_id": "019e4b02-f37b-72df-a3e5-bb0431cea2a5"
      },
      "expected_envelope": "expected/hub_and_spoke__not_found.expected.json",
      "expected_sql_snapshot": "expected/hub_and_spoke__not_found.sql.txt"
    }
  ]
}
