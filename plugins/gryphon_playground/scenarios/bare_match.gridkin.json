{
  "feature": "Bare labelless MATCH (n) — scan every registered node type",
  "background": {
    "grift_fixture": "fixtures/sparse_dense.grift.json"
  },
  "scenarios": [
    {
      "name": "labelless scan filtered by entity-type equality",
      "tags": ["bare-match", "spine-scan"],
      "covers": [
        "req-grid-traversal-lang-bare-match",
        "req-grid-traversal-lang-bare-match-1",
        "req-grid-traversal-lang-bare-match-4"
      ],
      "inspired_by": "opencypher TCK — clauses/match (all-node scan, no label)",
      "layer": "lite",
      "query": "MATCH (n) WHERE n.entity_type = \"pg_node\"",
      "expected_envelope": "expected/bare_match__entity_type_eq.expected.json",
      "expected_sql_snapshot": "expected/bare_match__entity_type_eq.sql.txt"
    },
    {
      "name": "labelless scan filtered by an entity-type prefix",
      "tags": ["bare-match", "spine-scan", "string-match"],
      "covers": [
        "req-grid-traversal-lang-bare-match-1",
        "req-grid-traversal-lang-bare-match-4",
        "req-grid-traversal-lang-string-match"
      ],
      "inspired_by": "opencypher TCK — clauses/match (all-node scan filtered by type prefix)",
      "layer": "lite",
      "query": "MATCH (n) WHERE n.entity_type STARTS_WITH \"pg_\"",
      "expected_envelope": "expected/bare_match__entity_type_prefix.expected.json",
      "expected_sql_snapshot": "expected/bare_match__entity_type_prefix.sql.txt"
    },
    {
      "name": "data-lane filter crosses every node type",
      "tags": ["bare-match", "data-lane"],
      "covers": [
        "req-grid-traversal-lang-bare-match-2"
      ],
      "inspired_by": "opencypher TCK — clauses/match (label-free scan spans all node types)",
      "layer": "lite",
      "query": "MATCH (n) WHERE n.data.kind = \"island\"",
      "expected_envelope": "expected/bare_match__data_lane_crosses.expected.json",
      "expected_sql_snapshot": "expected/bare_match__data_lane_crosses.sql.txt"
    },
    {
      "name": "data-lane filter selects a single crossed type",
      "tags": ["bare-match", "data-lane"],
      "covers": [
        "req-grid-traversal-lang-bare-match-2"
      ],
      "inspired_by": "opencypher TCK — clauses/match (label-free scan, single matching type)",
      "layer": "lite",
      "query": "MATCH (n) WHERE n.data.kind = \"hub\"",
      "expected_envelope": "expected/bare_match__data_lane_single.expected.json",
      "expected_sql_snapshot": "expected/bare_match__data_lane_single.sql.txt"
    },
    {
      "name": "a data-lane field absent from a type is silently non-matching",
      "tags": ["bare-match", "data-lane", "robustness"],
      "covers": [
        "req-grid-traversal-lang-bare-match-3"
      ],
      "inspired_by": "opencypher TCK — clauses/match (missing property is non-matching, not an error)",
      "layer": "lite",
      "query": "MATCH (n) WHERE n.data.bio = \"anything\"",
      "expected_envelope": "expected/bare_match__field_absent.expected.json",
      "expected_sql_snapshot": "expected/bare_match__field_absent.sql.txt"
    },
    {
      "name": "bare unfiltered labelless scan returns the whole node population",
      "tags": ["bare-match", "spine-scan"],
      "covers": [
        "req-grid-traversal-lang-bare-match",
        "req-grid-traversal-lang-bare-match-1"
      ],
      "inspired_by": "opencypher TCK — clauses/match (all-node scan with no predicate returns every node)",
      "layer": "lite",
      "query": "MATCH (n)",
      "expected_envelope": "expected/bare_match__all_nodes.expected.json",
      "expected_sql_snapshot": "expected/bare_match__all_nodes.sql.txt"
    }
  ]
}
