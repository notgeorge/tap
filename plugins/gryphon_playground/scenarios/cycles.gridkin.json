{
  "feature": "Cyclic topology — traversal returning to its origin, and self-loop edges",
  "background": {
    "grift_fixture": "fixtures/cycles.grift.json"
  },
  "scenarios": [
    {
      "name": "hub-and-spoke on a self-looped node returns the node through its loop edge",
      "tags": ["hub-and-spoke", "self-loop", "cycles", "current-behavior"],
      "covers": ["req-grid-traversal-lang-shape"],
      "inspired_by": "opencypher TCK — clauses/match (self-loop relationship)",
      "layer": "lite",
      "query": "MATCH (n)-[e]-(m) WHERE n.entity_id = $self_node",
      "params": {
        "self_node": "019e4e07-9975-7501-8d81-0fc238769248"
      },
      "expected_envelope": "expected/cycles__self_loop.expected.json",
      "expected_sql_snapshot": "expected/cycles__self_loop.sql.txt"
    },
    {
      "name": "three-hop traversal around a three-node cycle returns to the origin",
      "tags": ["multi-hop", "cycles", "current-behavior"],
      "covers": ["req-grid-gryphon-multihop"],
      "inspired_by": "opencypher TCK — clauses/match (cyclic path returns to origin)",
      "layer": "lite",
      "query": "MATCH (a)-[:PG_LINKS__gryphon_playground]->(b)-[:PG_LINKS__gryphon_playground]->(c)-[:PG_LINKS__gryphon_playground]->(d) WHERE a.entity_id = $node_a",
      "params": {
        "node_a": "019e4e07-9975-7501-8d81-0fbf70e51757"
      },
      "expected_envelope": "expected/cycles__three_hop.expected.json",
      "expected_sql_snapshot": "expected/cycles__three_hop.sql.txt"
    },
    {
      "name": "COUNT correctly counts a self-loop relationship",
      "tags": ["aggregation", "count", "self-loop", "tck-inspired"],
      "covers": ["req-grid-gryphon-count", "req-grid-gryphon-rows"],
      "inspired_by": "opencypher TCK — expressions/aggregation",
      "layer": "lite",
      "query": "MATCH (n)-[:PG_LINKS__gryphon_playground]->(m) RETURN n.entity_id AS node_id, COUNT(m) AS out_degree",
      "expected_envelope": "expected/cycles__count_self_loop.expected.json",
      "expected_sql_snapshot": "expected/cycles__count_self_loop.sql.txt"
    }
  ]
}
