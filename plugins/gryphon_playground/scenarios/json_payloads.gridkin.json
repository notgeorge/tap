{
  "feature": "WHERE predicates that walk into a per-model JSON field",
  "background": {
    "grift_fixture": "fixtures/json_payloads.grift.json"
  },
  "scenarios": [
    {
      "name": "WHERE on a nested JSON tag key filters the type-scan",
      "tags": ["type-scan", "where", "json-payload", "current-behavior"],
      "covers": [
        "req-grid-traversal-lang-filters",
        "req-grid-traversal-lang-envelope-paths-2"
      ],
      "inspired_by": "opencypher TCK — expressions/map (nested map/key access in a predicate)",
      "layer": "full",
      "query": "MATCH (n:pg_node) WHERE n.data.tags.team = \"infra\"",
      "expected_envelope": "expected/json_payloads__team_infra.expected.json",
      "expected_sql_snapshot": "expected/json_payloads__team_infra.sql.txt"
    },
    {
      "name": "WHERE on a JSON key absent from some nodes matches only nodes that have it",
      "tags": ["type-scan", "where", "json-payload", "tck-inspired"],
      "covers": [
        "req-grid-traversal-lang-filters",
        "req-grid-traversal-lang-envelope-paths-2"
      ],
      "inspired_by": "opencypher TCK — clauses/match-where",
      "layer": "full",
      "query": "MATCH (n:pg_node) WHERE n.data.tags.priority = \"high\"",
      "expected_envelope": "expected/json_payloads__priority_high.expected.json",
      "expected_sql_snapshot": "expected/json_payloads__priority_high.sql.txt"
    },
    {
      "name": "JSON tag key access is case-sensitive — wrong-case key matches nothing",
      "tags": ["type-scan", "where", "json-payload", "tck-inspired"],
      "covers": [
        "req-grid-traversal-lang-filters",
        "req-grid-traversal-lang-envelope-paths-2"
      ],
      "inspired_by": "opencypher TCK — expressions/map (map key access is case-sensitive; a mis-cased key resolves to null rather than the same-spelled lower-case key)",
      "layer": "lite",
      "query": "MATCH (n:pg_node) WHERE n.data.tags.Team = \"infra\"",
      "expected_envelope": "expected/json_payloads__team_wrong_case.expected.json",
      "expected_sql_snapshot": "expected/json_payloads__team_wrong_case.sql.txt"
    },
    {
      "name": "Walking a sub-key into a scalar tag value resolves to null, not an error",
      "tags": ["type-scan", "where", "json-payload", "tck-inspired"],
      "covers": [
        "req-grid-traversal-lang-filters",
        "req-grid-traversal-lang-envelope-paths-2"
      ],
      "inspired_by": "opencypher TCK — expressions/map (indexing a deeper key into a non-map scalar yields null, not a runtime error)",
      "layer": "lite",
      "query": "MATCH (n:pg_node) WHERE n.data.tags.team.region = \"infra\"",
      "expected_envelope": "expected/json_payloads__scalar_subkey_null.expected.json",
      "expected_sql_snapshot": "expected/json_payloads__scalar_subkey_null.sql.txt"
    }
  ]
}
