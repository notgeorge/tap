            "entity_type": "panel",
            "name": "Batch Viewer",
            "dimensions": {"tap.graph": "web"}
          },
          "node": {
            "slug": "administrivia-batch-viewer",
            "name": "Batch Viewer",
            "description": "Batch viewer panel instance. Resolves a batch via tap_web.panels.entity_resolution (deep link via batch_entity_id wins; else latest by started_at) and shows its nodes/edges added, deletes, and purges.",
            "view": "tap_web/panels/batch_viewer.html",
            "config": {
              "entity_id_var": "batch_entity_id",
              "fallback": {
                "query": "MATCH (b:batch) WHERE b.data.started_at IS NOT NULL ORDER BY b.data.started_at DESC LIMIT 1",
                "description": "Most recent batch by started_at."
              }
            }
          }
        },
        {
          "entity": {
            "entity_id": "019e7adc-3d1f-7e2a-8d8e-c384bdc24379",
            "entity_type": "panel",
            "name": "Batch Sequence Nav",
            "dimensions": {"tap.graph": "web"}
          },
          "node": {
            "slug": "administrivia-batch-nav",
            "name": "Batch Sequence Nav",
            "description": "Back/forward selector over batches. Shares batch_entity_id with the viewer below; resolves the newest-first sequence of batches by started_at.",
            "view": "tap_web/panels/sequence_nav.html",
            "config": {
              "entity_id_var": "batch_entity_id",
              "sequence": {
                "query": "MATCH (b:batch) WHERE b.data.started_at IS NOT NULL ORDER BY b.data.started_at DESC LIMIT 200",
                "label_field": "started_at",
                "label": "Batch"
              }
            }
          }
        }
