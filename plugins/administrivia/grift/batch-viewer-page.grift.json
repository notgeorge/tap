            "entity_type": "page",
            "name": "Batch",
            "dimensions": {"tap.graph": "web"}
          },
          "node": {
            "name": "Batch",
            "slug": "/administrivia/batch",
            "discoverable": false,
            "layout": {
              "columns": {
                "col-1": {
                  "width": "1fr",
                  "rows": {
                    "row-1-nav": {"panel-id": "nav", "height": "auto"},
