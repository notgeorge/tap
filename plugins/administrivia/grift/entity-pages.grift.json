          },
          "node": {
            "name": "Entity Neighborhood",
            "description": "Hub-and-spoke neighborhood graph for a single entity.",
            "search_type": "gryphon",
            "root": "node",
            "definition": {
              "query": [
                "MATCH (hub)-[e]-(neighbor)",
                "WHERE hub.entity_id = $entity_id",
                "RETURN hub, e, neighbor"
              ]
            },
            "input_schema": {
              "type": "object",
              "required": ["entity_id"],
              "properties": {
                "entity_id": {"type": "string"}
              }
            },
            "default_limit": 200,
            "max_limit": 500
