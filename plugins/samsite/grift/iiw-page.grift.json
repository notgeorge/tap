      "batch_node": {
        "source": "plugins.samsite.grift.iiw-page",
        "name": "Samsite IIW viewer page v0.1.0",
        "description": "Seeds /samsite/compliance/iiw: a classy workbench view of the IIW inventory workbook (samsite-iiw-workbench, CSV -> Tabulator) with a sequence-nav selector above it. Both share iiw_artifact_entity_id; the workbench falls back to the latest iiw compliance_artifact by fetched_at."
      },
      "nodes": [
        {
          "entity": {
            "entity_id": "019e7574-fb02-7351-98d9-b9ab2f19689c",
            "entity_type": "page",
            "name": "IIW",
            "dimensions": {"tap.graph": "web"}
          },
          "node": {
            "name": "IIW",
            "slug": "/samsite/compliance/iiw",
            "layout": {
              "full_bleed": true,
              "columns": {
                "col-1": {
                  "width": "1fr",
                  "rows": {
                    "row-1-nav": {"panel-id": "nav", "height": "auto"},
                    "row-2-workbench": {"panel-id": "workbench", "height": "1fr"}
                  }
                }
              }
            }
          }
        },
        {
          "entity": {
            "entity_id": "019e7574-fb02-7351-98d9-b9ae88a3443c",
            "entity_type": "panel",
            "name": "Samsite IIW Workbench",
            "dimensions": {"tap.graph": "web"}
          },
          "node": {
            "slug": "samsite-iiw-workbench",
            "name": "Samsite IIW Workbench",
            "description": "IIW inventory workbench panel instance. Resolves an iiw compliance_artifact via tap_web.panels.entity_resolution (deep link via iiw_artifact_entity_id wins; else latest by fetched_at) and renders its CSV content as a Tabulator table.",
            "view": "samsite/panels/iiw_workbench.html",
            "config": {
              "entity_id_var": "iiw_artifact_entity_id",
              "fallback": {
                "query": "MATCH (a:compliance_artifact) WHERE a.data.kind = \"iiw\" AND a.data.fetched_at IS NOT NULL ORDER BY a.data.fetched_at DESC LIMIT 1",
                "description": "Latest iiw compliance artifact by fetched_at."
              }
            }
          }
        },
        {
          "entity": {
            "entity_id": "019e7574-fb02-7351-98d9-b9ad72e09ca6",
            "entity_type": "panel",
            "name": "Samsite IIW Sequence Nav",
            "dimensions": {"tap.graph": "web"}
          },
          "node": {
            "slug": "samsite-iiw-nav",
            "name": "Samsite IIW Sequence Nav",
            "description": "Back/forward selector over IIW emissions. Shares iiw_artifact_entity_id with the workbench below; resolves the newest-first sequence of iiw compliance_artifacts by fetched_at.",
            "view": "tap_web/panels/sequence_nav.html",
            "config": {
              "entity_id_var": "iiw_artifact_entity_id",
              "sequence": {
                "query": "MATCH (a:compliance_artifact) WHERE a.data.kind = \"iiw\" AND a.data.fetched_at IS NOT NULL ORDER BY a.data.fetched_at DESC LIMIT 200",
                "label_field": "fetched_at",
                "label": "IIW"
              }
            }
          }
        }
