      "batch_node": {
        "source": "plugins.samsite.grift.ksi-signal-page",
        "name": "Samsite KSI Signal viewer page v0.1.0",
        "description": "Seeds /samsite/compliance/ksi-signal: a classy workbench view of one KSI signal (samsite-ksi-signal-workbench), with a sequence-nav selector mounted above it. Both panels share ksi_signal_entity_id; the workbench falls back to the latest ksi_signal by emitted_at, the selector walks the emission sequence."
      },
      "nodes": [
        {
          "entity": {
            "entity_id": "019e7550-0607-7043-bac9-d7e37c04048c",
            "entity_type": "page",
            "name": "KSI Signal",
            "dimensions": {"tap.graph": "web"}
          },
          "node": {
            "name": "KSI Signal",
            "slug": "/samsite/compliance/ksi-signal",
            "layout": {
              "columns": {
                "col-1": {
                  "width": "1fr",
                  "rows": {
                    "row-1-nav": {"panel-id": "nav", "height": "auto"},
                    "row-2-workbench": {"panel-id": "workbench", "height": "1fr"}
                  }
                }
              }
            }
          }
        },
        {
          "entity": {
            "entity_id": "019e7550-0607-7043-bac9-d7e60b747650",
            "entity_type": "panel",
            "name": "Samsite KSI Signal Workbench",
            "dimensions": {"tap.graph": "web"}
          },
          "node": {
            "slug": "samsite-ksi-signal-workbench",
            "name": "Samsite KSI Signal Workbench",
            "description": "KSI signal workbench panel instance. Resolves a ksi_signal via tap_web.panels.entity_resolution (deep link via ksi_signal_entity_id wins; else latest by emitted_at) and recomposes its components / validations / violations from the grid.",
            "view": "samsite/panels/ksi_signal_workbench.html",
            "config": {
              "entity_id_var": "ksi_signal_entity_id",
              "fallback": {
                "query": "MATCH (s:ksi_signal) WHERE s.data.emitted_at IS NOT NULL ORDER BY s.data.emitted_at DESC LIMIT 1",
                "description": "Latest ksi_signal emission by emitted_at."
              }
            }
          }
        },
        {
          "entity": {
            "entity_id": "019e7550-0607-7043-bac9-d7e57bc8daaa",
            "entity_type": "panel",
            "name": "Samsite KSI Signal Sequence Nav",
            "dimensions": {"tap.graph": "web"}
          },
          "node": {
            "slug": "samsite-ksi-signal-nav",
            "name": "Samsite KSI Signal Sequence Nav",
            "description": "Back/forward selector over KSI signal emissions. Shares ksi_signal_entity_id with the workbench below; resolves the newest-first sequence of ksi_signal by emitted_at.",
            "view": "tap_web/panels/sequence_nav.html",
            "config": {
              "entity_id_var": "ksi_signal_entity_id",
              "sequence": {
                "query": "MATCH (s:ksi_signal) WHERE s.data.emitted_at IS NOT NULL ORDER BY s.data.emitted_at DESC LIMIT 200",
                "label_field": "emitted_at",
                "label": "KSI Signal"
              }
            }
          }
        }
      ],
