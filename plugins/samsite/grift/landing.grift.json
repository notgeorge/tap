        "source": "plugins.samsite",
        "name": "Samsite landing v0.1.0",
        "description": "Landing page: cytoscape graph panel projecting the samsite-tagged AWS resources for account 180731181784. The aws_account container node is no longer minted here — the aws_core boto3 collector now synthesizes it (aws_account_singleton custom_fn, deterministic uuid5); the samsite multi-MATCH search's MATCH (account:aws_account) resolves against the collector-owned node."
      },
      "nodes": [
        {
          "entity": {
            "entity_id": "eb9fb415-ba8d-57e5-ab3f-1e2411ce0822",
            "entity_type": "search",
            "name": "Samsite — Project=samsite nodes (multi-MATCH)",
            "dimensions": {}
          },
          "node": {
            "name": "Samsite — Project=samsite nodes (multi-MATCH)",
            "description": "Gryphon multi-MATCH: aws_account + boundary (both unfiltered — they bind variables other than `n`, so the tag WHERE doesn't apply) plus every aws_* type tagged `Project=samsite` by the Terraform pass. Per spec-grid-traversal-language § Envelope-Aware Field Paths, `data.tags.Project` walks the per-model tags JSONField via Django nested lookup. One MATCH per entity_type because bare `MATCH (n)` type-scan without a label isn't supported today (Future: req-grid-traversal-lang-patterns).",
            "search_type": "gryphon",
            "root": "node",
            "definition": {
              "query": [
                "MATCH (account:aws_account)",
                "MATCH (b:boundary)",
                "MATCH (n:aws_lambda)",
                "MATCH (n:aws_cloudfront_distribution)",
                "MATCH (n:aws_route53_zone)",
                "MATCH (n:aws_acm_certificate)",
                "MATCH (n:aws_eventbridge_rule)",
                "MATCH (n:aws_s3_bucket)",
                "MATCH (n:aws_cloudwatch_log_group)",
                "MATCH (n:aws_iam_role)",
                "MATCH (n:aws_dynamodb_table)",
                "MATCH (n:aws_iam_oidc_provider)",
                "WHERE n.data.tags.Project = \"samsite\""
              ]
            }
          }
        },
