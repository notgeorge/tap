      "nodes": [
        {
          "entity": {
            "entity_id": "eb9fb415-ba8d-57e5-ab3f-1e2411ce0822",
            "entity_type": "search",
            "name": "Samsite \u2014 Project=samsite nodes",
            "dimensions": {}
          },
          "node": {
            "name": "Samsite \u2014 Project=samsite nodes",
            "description": "Gryphon: aws_account + boundary (both unfiltered \u2014 they bind variables other than `n`, so the tag WHERE doesn't apply) plus a bare `MATCH (n)` typeless scan filtered to Project=samsite via the per-model tags JSONField. The bare-MATCH support landed alongside this query's amendment \u2014 collapsed eleven `MATCH (n:aws_*)` clauses into one. Per spec-grid-traversal-language \u00a7 Envelope-Aware Field Paths, `data.tags.Project` walks the per-model tags JSONField via Django nested lookup; nodes without `data.tags` (compliance models, etc.) gracefully don't match.",
            "search_type": "gryphon",
            "root": "node",
            "definition": {
              "query": [
                "MATCH (account:aws_account)",
                "MATCH (b:boundary)",
                "MATCH (n)",
                "WHERE n.data.tags.Project = \"samsite\""
              ]
            }
          }
        },
