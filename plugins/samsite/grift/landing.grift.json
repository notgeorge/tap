      "batch_node": {
        "source": "plugins.samsite",
        "name": "Samsite landing v0.1.0",
        "description": "Landing page: cytoscape graph panel projecting the samsite-tagged AWS resources for account 180731181784. The aws_account container node is no longer minted here \u2014 the aws_core boto3 collector now synthesizes it (aws_account_singleton custom_fn, deterministic uuid5); the samsite multi-MATCH search's MATCH (account:aws_account) resolves against the collector-owned node."
      },
      "nodes": [
        {
          "entity": {
            "entity_id": "eb9fb415-ba8d-57e5-ab3f-1e2411ce0822",
            "entity_type": "search",
            "name": "Samsite \u2014 Project=samsite nodes",
            "dimensions": {}
          },
          "node": {
            "name": "Samsite \u2014 Project=samsite nodes",
            "description": "Gryphon: aws_account + boundary (both unfiltered \u2014 they bind variables other than `n`, so the tag WHERE doesn't apply) plus a bare `MATCH (n)` typeless scan filtered to Project=samsite via the per-model tags JSONField. The bare-MATCH support landed alongside this query's amendment \u2014 collapsed eleven `MATCH (n:aws_*)` clauses into one. Per spec-grid-traversal-language \u00a7 Envelope-Aware Field Paths, `data.tags.Project` walks the per-model tags JSONField via Django nested lookup; nodes without `data.tags` (compliance models, etc.) gracefully don't match.",
            "search_type": "gryphon",
            "root": "node",
            "definition": {
              "query": [
                "MATCH (account:aws_account)",
                "MATCH (b:boundary)",
                "MATCH (n)",
                "WHERE n.data.tags.Project = \"samsite\""
              ]
            }
          }
        },
        {
          "entity": {
            "entity_id": "c0a6a6cf-89b3-5b78-8c5e-fb55ad33b85e",
            "entity_type": "search",
            "name": "Samsite \u2014 all edges (graph_panel filters by node-set)",
            "dimensions": {}
          },
          "node": {
            "name": "Samsite \u2014 all edges (graph_panel filters by node-set)",
            "description": "All edges; graph_panel keeps only those whose endpoints are in the matched node-set (tap_viz/static/tap_viz/js/panel-graph.js).",
            "search_type": "orm",
            "root": "edge",
            "definition": {
              "filters": {},
              "order_by": [
                "edge_type"
              ]
            }
          }
        },
        {
          "entity": {
            "entity_id": "e49c40aa-508a-5751-9c58-7df6b73ff385",
            "entity_type": "layout",
            "name": "samsite-landing-layout",
            "dimensions": {
              "tap.graph": "web"
            }
          },
          "node": {
            "name": "samsite-landing-layout",
            "description": "Four-system side-by-side layout. landing-systems.js places each system's anchor (dns/site/compliance/bootstrap) at a fixed X; the four per-Component arrangements then stack each system's members vertically below its anchor \u2014 giving four side-by-side story columns the user can tweak independently by editing the corresponding Arrangement entity.",
            "definition": {
              "js_file": "plugins/samsite/static/samsite/js/projections/landing-systems.js",
              "arrangements": [
                "019e646a-85fc-7159-b12b-c6615684ac4c",
                "019e646a-85fc-7159-b12b-c6629f88777b",
                "019e646a-85fc-7159-b12b-c663337116a2",
                "019e646a-85fc-7159-b12b-c66477eb82f5"
              ]
            }
          }
        },
        {
          "entity": {
            "entity_id": "019e646a-85fc-7159-b12b-c6615684ac4c",
            "entity_type": "arrangement",
            "name": "samsite-dns-arrangement",
            "dimensions": {
              "tap.graph": "web"
            }
          },
          "node": {
            "name": "samsite-dns-arrangement",
            "description": "DNS column \u2014 anchored on the Route53 hosted zone (samsite.unified-systems.com). One member today: the ACM certificate. Vertical column under the anchor; tweak spacing here without touching the layout module.",
            "definition": {
              "anchor": {
                "gryphon": "MATCH (n:aws_route53_zone) WHERE n.data.tags.Project = \"samsite\" AND n.data.tags.Component = \"dns\""
              },
              "members": {
                "gryphon": "MATCH (n) WHERE n.data.tags.Project = \"samsite\" AND n.data.tags.Component = \"dns\""
              },
              "positioning": "vertical",
              "distribution": "even",
              "anchor_offset_px": 120
            }
          }
        },
        {
          "entity": {
            "entity_id": "019e646a-85fc-7159-b12b-c6629f88777b",
            "entity_type": "arrangement",
            "name": "samsite-site-arrangement",
            "dimensions": {
              "tap.graph": "web"
            }
          },
          "node": {
            "name": "samsite-site-arrangement",
            "description": "Site-serving column \u2014 anchored on the CloudFront distribution. One member today: the S3 origin bucket (samsite-prod-1). Vertical column under the anchor. Visually pairs with the dns column to read as the public-facing website story.",
            "definition": {
              "anchor": {
                "gryphon": "MATCH (n:aws_cloudfront_distribution) WHERE n.data.tags.Project = \"samsite\" AND n.data.tags.Component = \"site\""
              },
              "members": {
                "gryphon": "MATCH (n) WHERE n.data.tags.Project = \"samsite\" AND n.data.tags.Component = \"site\""
              },
              "positioning": "vertical",
              "distribution": "even",
              "anchor_offset_px": 120
            }
          }
        },
        {
