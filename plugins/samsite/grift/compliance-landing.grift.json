          "node": {
            "slug": "samsite-vdr-ingestion-health",
            "name": "Samsite VDR Ingestion Health",
            "description": "Consumer-side complement to the upstream VDR aggregator's kev_catalog_loaded + dependabot_alerts_loaded disclosure flags. Renders check/cross pills from the latest vdr_report.summary; if either flips false, the panel turns red and warns the user. Resolves via tap_web.panels.entity_resolution: URL deep link via vdr_report_entity_id wins; otherwise the fallback Gryphon query picks the latest emission by emitted_at.",
            "view": "samsite/panels/vdr_ingestion_health.html",
            "config": {
              "entity_id_var": "vdr_report_entity_id",
              "fallback": {
                "query": "MATCH (r:vdr_report) WHERE r.data.emitted_at IS NOT NULL ORDER BY r.data.emitted_at DESC LIMIT 1",
                "description": "Latest vdr_report by emitted_at \u2014 the most recent VDR aggregator emission on the grid."
              }
            }
          }
        }
