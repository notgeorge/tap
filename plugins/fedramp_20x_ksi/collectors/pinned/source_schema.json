{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fedramp.gov/schema/documentation.json",
  "title": "FedRAMP Consolidated Rules Schema (KSI-scoped subset)",
  "description": "Validates the part of the FedRAMP Consolidated Rules document that the KSI collector actually ingests. Top-level structure is strict (the four sibling sections must exist and no extras are allowed) but only the KSI subtree is validated in depth. The info / FRR / FRD sections are accepted as opaque sibling data because we do not ingest them. See req-fedramp-20x-ksi-collector-validation-scope.",
  "type": "object",
  "required": ["info", "FRD", "FRR", "KSI"],
  "properties": {
    "info": { "type": "object" },
    "FRD":  { "type": "object" },
    "FRR":  { "type": "object" },
    "KSI": {
      "type": "object",
      "patternProperties": {
        "^[A-Z]{3}$": {
          "type": "object",
          "required": ["id", "name", "web_name", "short_name", "indicators"],
          "properties": {
            "id": { "type": "string", "pattern": "^KSI-[A-Z]{3}$" },
            "name": { "type": "string" },
            "web_name": { "type": "string" },
            "short_name": { "type": "string", "pattern": "^[A-Z]{3}$" },
            "status": { "type": "string" },
            "indicators": {
              "type": "object",
              "patternProperties": {
                "^KSI-[A-Z]{3}-[A-Z0-9]{3}$": {
                  "$ref": "#/$defs/ksi_indicator"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ksi_indicator": {
      "type": "object",
      "required": ["name", "controls", "updated"],
      "oneOf": [
        {
          "properties": { "statement": {} },
          "required": ["statement"]
        },
        {
          "properties": { "varies_by_class": {} },
          "required": ["varies_by_class"]
        }
      ],
      "properties": {
        "name": { "type": "string" },
        "statement": { "type": "string" },
        "controls": { "type": "array", "items": { "type": "string" } },
        "reference": { "type": "string" },
        "reference_url": { "type": "string", "format": "uri" },
        "updated": { "$ref": "#/$defs/updated_list" },
        "varies_by_class": {
          "type": "object",
          "required": ["b", "c"],
          "properties": {
            "a": { "$ref": "#/$defs/ksi_indicator_level" },
            "b": { "$ref": "#/$defs/ksi_indicator_level" },
            "c": { "$ref": "#/$defs/ksi_indicator_level" },
            "d": { "$ref": "#/$defs/ksi_indicator_level" }
          },
          "additionalProperties": false
        },
        "terms": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "ksi_indicator_level": {
      "type": "object",
      "required": ["statement"],
      "properties": {
        "statement": { "type": "string" }
      },
      "additionalProperties": false
    },
    "updated_list": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "comment"],
        "properties": {
          "date": { "type": "string", "format": "date" },
          "comment": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  }
}
