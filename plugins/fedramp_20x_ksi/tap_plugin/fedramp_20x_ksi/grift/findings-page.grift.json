      "batch_node": {
        "source": "plugins.fedramp_20x_ksi",
        "name": "fedramp_20x_ksi findings page v0.1.1 \u2014 single global WHERE fix",
        "description": "Seeds the Findings index page with two panels (findings_by_system, findings_by_ksi). v0.1.1 surfaces panel headers \u2014 panel names changed to 'By System' / 'By KSI' (the page-level title 'Findings' provides the outer context, so the panels read as 'Findings: By System' / 'Findings: By KSI' visually). hide_header dropped on both instances so the standard tap_web panel header renders."
      },
      "nodes": [
        {
          "entity": {
            "entity_id": "019df978-4b6f-75cd-ac14-cf662904da16",
            "entity_type": "search",
            "name": "All Open Findings With KSI Linkage",
            "dimensions": {
              "tap.graph": "web"
            }
          },
          "node": {
            "name": "All Open Findings With KSI Linkage",
            "description": "Returns every open finding plus its HAS_FINDING parent (the system the finding applies to) and any RELATED_INDICATOR linkage to a KSI indicator. Multi-MATCH UNION-dedup so findings without a KSI link still appear in the envelope (the findings_by_ksi panel filters those out client-side; findings_by_system shows them).",
            "search_type": "gryphon",
            "root": "node",
            "definition": {
              "query": "MATCH (s)-[h:HAS_FINDING]->(f:finding)\nMATCH (f:finding)-[r:RELATED_INDICATOR]->(i:ksi_indicator)\nWHERE f.status = \"open\""
            },
            "default_limit": 200,
            "max_limit": 500
          }
        },
