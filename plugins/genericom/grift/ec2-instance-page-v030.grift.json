        "description": "Adds the new search, hero panel, findings panel, and the USES_PANEL + USES_SEARCH edges that connect them to the existing EC2 instance page. Page layout is bumped in batch 2 (Genericom EC2 instance page v0.3.0 — layout) so the hotlink-exact validator sees the new edges before the layout references them. See spec-genericom-ec2-projection.md req-genericom-ec2-page-layout."
      },
      "nodes": [
        {
          "entity": {
            "entity_id": "019dfa48-c5ed-7184-ae89-6d581907e5ad",
            "entity_type": "search",
            "name": "EC2 Instance Findings",
            "dimensions": {"compliance": "fedramp-20x"}
          },
          "node": {
            "name": "EC2 Instance Findings",
            "description": "Per-asset findings + their evidence + their related KSI indicators, all in one gryphon pass. Consumed by the fedramp-20x-ksi-instance-findings panel.",
            "search_type": "gryphon",
            "root": "node",
            "input_schema": {
              "type": "object",
              "properties": {"entity_id": {"type": "string", "format": "uuid"}},
              "required": ["entity_id"]
            },
            "definition": {
              "query": [
                "MATCH (asset)-[hf:HAS_FINDING]->(f:finding) WHERE asset.entity_id = $entity_id",
                "MATCH (asset2)-[hf2:HAS_FINDING]->(f2:finding)-[he:HAS_EVIDENCE]->(ev:evidence) WHERE asset2.entity_id = $entity_id",
                "MATCH (asset3)-[hf3:HAS_FINDING]->(f3:finding)-[ri:RELATED_INDICATOR]->(ksi:ksi_indicator) WHERE asset3.entity_id = $entity_id"
              ]
            },
            "default_limit": 200,
            "max_limit": 500
          }
        },
