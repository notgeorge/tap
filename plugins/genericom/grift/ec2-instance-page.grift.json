      "nodes": [
        {
          "entity": {
            "entity_id": "019dd143-3e8f-73e4-b0fa-e70fbb2ebd34",
            "entity_type": "search",
            "name": "EC2 Instance Internal Slice",
            "dimensions": {}
          },
          "node": {
            "name": "EC2 Instance Internal Slice",
            "description": "Gathers computing-core internals for an EC2 instance: interfaces, IPs, ports, programs, libraries, TCP connections, and the remote-side endpoints.",
            "search_type": "gryphon",
            "root": "node",
            "input_schema": {
              "type": "object",
              "properties": {
                "entity_id": {"type": "string", "format": "uuid"}
              },
              "required": ["entity_id"]
            },
            "definition": {
              "query": [
                "MATCH (ec2)-[h:HOSTS]->(child) WHERE ec2.entity_id = $entity_id",
                "MATCH (ec2)-[h2:HOSTS]->(iface:network_interface)-[hi:HAS_IP]->(ip:ip_address) WHERE ec2.entity_id = $entity_id",
                "MATCH (ec2)-[h3:HOSTS]->(iface2:network_interface)<-[at:ATTACHED_TO]-(port:port) WHERE ec2.entity_id = $entity_id",
                "MATCH (ec2)-[h4:HOSTS]->(prog:program)-[l:LISTENS_ON]->(port2:port) WHERE ec2.entity_id = $entity_id",
                "MATCH (ec2)-[h5:HOSTS]->(prog2:program)-[d:DEPENDS_ON]->(f:file) WHERE ec2.entity_id = $entity_id",
                "MATCH (ec2)-[h6:HOSTS]->(f2:file)-[cn:CONTAINS]->(pub:public_key)-[pw:PAIRED_WITH]->(priv:private_key) WHERE ec2.entity_id = $entity_id",
                "MATCH (src)-[c1:CONNECTS_TO]->(tcp:tcp_connection)-[c2:CONNECTS_TO]->(port3:port)-[at2:ATTACHED_TO]->(iface3:network_interface)<-[h7:HOSTS]-(ec2) WHERE ec2.entity_id = $entity_id",
                "MATCH (ec2)-[h8:HOSTS]->(prog3:program)-[c3:CONNECTS_TO]->(tcp2:tcp_connection)-[c4:CONNECTS_TO]->(rport:port)<-[rh:HOSTS]-(remote) WHERE ec2.entity_id = $entity_id",
                "MATCH (ec2)-[h9:HOSTS]->(prog4:program)-[c5:CONNECTS_TO]->(tcp3:tcp_connection)-[c6:CONNECTS_TO]->(rport2:port)-[av:AVAILABLE_AT]->(rip:ip_address) WHERE ec2.entity_id = $entity_id"
              ]
            }
          }
        },
        {
