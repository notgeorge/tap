        "description": "Seeds the Open Alerts table panel beneath the Genericom AWS top-level graph: Search (gryphon, multi-MATCH including RELATED_INDICATOR), Panel (genericom-open-alerts type), USES_SEARCH and USES_PANEL edges."
      },
      "nodes": [
        {
          "entity": {
            "entity_id": "019df4d9-9274-721d-a87a-260c0a050ae8",
            "entity_type": "search",
            "name": "Genericom Open Alerts",
            "dimensions": {
              "tap.graph": "web"
            }
          },
          "node": {
            "name": "Genericom Open Alerts",
            "description": "Gryphon query returning all open findings joined to their parent system via HAS_FINDING and any related KSI indicators via RELATED_INDICATOR. Two MATCH clauses (UNION-dedup) so findings without a KSI link still appear.",
            "search_type": "gryphon",
            "root": "node",
            "definition": {
              "query": "MATCH (s)-[h:HAS_FINDING]->(f:finding) WHERE f.status = \"open\"\nMATCH (f:finding)-[r:RELATED_INDICATOR]->(i:ksi_indicator) WHERE f.status = \"open\""
            },
            "default_limit": 200,
            "max_limit": 500
          }
        },
        {
          "entity": {
            "entity_id": "019df4d9-9274-721d-a87a-260d130b62e3",
