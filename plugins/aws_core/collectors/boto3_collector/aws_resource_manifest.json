{
  "manifest_version": "0",
  "entries": [
    {
      "entity_type": "aws_account",
      "service": "sts",
      "scope": "global",
      "source": { "custom_fn": "aws_account_singleton" },
      "why": "The AWS account this run is scoped to — the container every collected resource belongs to. Synthesized from STS GetCallerIdentity; no AWS API enumerates 'the account' as a resource.",
      "items_path": "[]",
      "natural_key": "Account",
      "fields": {
        "name": "_account_name",
        "account_id": "Account"
      }
    },
    {
      "entity_type": "aws_lambda",
      "service": "lambda",
      "scope": "regional",
      "source": { "aws_op": "ListFunctions" },
      "why": "Enumerate Lambda functions — serverless compute and a common runtime/compliance surface.",
      "items_path": "Functions[]",
      "natural_key": "FunctionArn",
      "fields": {
        "name": "FunctionName",
        "function_arn": "FunctionArn",
        "runtime": "Runtime",
        "handler": "Handler",
        "memory_size": "MemorySize",
        "timeout": "Timeout"
      },
      "tags": {
        "source": "rgta",
        "resource_type_filter": "lambda:function",
        "why": "Resource tags — ownership / environment / cost / compliance scoping."
      },
      "edges": [
        {
          "value_path": "Role",
          "target_type": "aws_iam_role",
          "key_kind": "arn",
          "edge_type": "ASSUMES_ROLE",
          "direction": "outbound"
        },
        {
          "value_path": "LoggingConfig.LogGroup",
          "target_type": "aws_cloudwatch_log_group",
          "key_kind": "name",
          "edge_type": "WRITES_LOGS",
          "direction": "outbound"
        }
      ]
    },
    {
      "entity_type": "aws_iam_role",
      "service": "iam",
      "scope": "global",
      "source": { "aws_op": "ListRoles" },
      "why": "Enumerate IAM roles — assumption targets and the identity backbone for service permissions.",
      "items_path": "Roles[]",
      "natural_key": "Arn",
      "fields": {
        "name": "RoleName",
        "role_arn": "Arn",
        "path": "Path",
        "max_session_duration": "MaxSessionDuration"
      },
      "tags": {
        "source": "service",
        "op": "ListRoleTags",
        "params": {
          "RoleName": { "from": "RoleName" }
        },
        "path": "Tags",
        "shape": "list_kv",
        "why": "Resource tags — RGTA excludes IAM roles; per-service side-quest."
      },
      "edges": [
        {
          "value_path": "AssumeRolePolicyDocument.Statement[].Principal.Federated",
          "target_type": "aws_iam_oidc_provider",
          "key_kind": "arn",
          "edge_type": "FEDERATES_INTO",
          "direction": "inbound"
        }
      ]
    },
    {
      "entity_type": "aws_eventbridge_rule",
      "service": "events",
      "scope": "regional",
      "source": { "aws_op": "ListRules" },
      "why": "Enumerate EventBridge rules — event/schedule triggers and their invocation roles.",
      "items_path": "Rules[]",
      "natural_key": "Arn",
      "fields": {
        "name": "Name",
        "rule_arn": "Arn",
        "state": "State",
        "schedule_expression": "ScheduleExpression",
        "event_bus_name": "EventBusName"
      },
      "tags": {
        "source": "rgta",
        "resource_type_filter": "events:rule",
        "why": "Resource tags — ownership / environment / cost / compliance scoping."
      },
      "edges": [
        {
          "value_path": "RoleArn",
          "target_type": "aws_iam_role",
          "key_kind": "arn",
          "edge_type": "ASSUMES_ROLE",
          "direction": "outbound"
        }
      ]
    },
    {
      "entity_type": "aws_cloudwatch_log_group",
      "service": "logs",
      "scope": "regional",
      "source": { "aws_op": "DescribeLogGroups" },
      "why": "Enumerate CloudWatch log groups — log destinations and audit-trail surfaces.",
      "items_path": "logGroups[]",
      "natural_key": "logGroupName",
      "fields": {
        "name": "logGroupName",
        "log_group_arn": "arn",
        "retention_in_days": "retentionInDays"
      },
      "tags": {
        "source": "rgta",
        "resource_type_filter": "logs:log-group",
        "arn_from": "logGroupArn",
        "why": "Resource tags; arn_from logGroupArn (RGTA ARN omits the describe ':*' suffix)."
      },
      "edges": []
    },
    {
      "entity_type": "aws_acm_certificate",
      "service": "acm",
      "scope": "regional",
      "source": { "aws_op": "ListCertificates" },
      "why": "Enumerate ACM certificates — TLS certificates and their issuance/expiry state.",
      "items_path": "CertificateSummaryList[]",
      "natural_key": "CertificateArn",
      "fields": {
        "name": "DomainName",
        "certificate_arn": "CertificateArn",
        "domain_name": "DomainName",
        "status": "Status"
      },
      "tags": {
        "source": "rgta",
        "resource_type_filter": "acm:certificate",
        "why": "Resource tags; CloudFront-bound certs only in us-east-1 (region invariant)."
      },
      "edges": []
    },
    {
      "entity_type": "aws_cloudfront_distribution",
      "service": "cloudfront",
      "scope": "global",
      "source": { "custom_fn": "cloudfront_distributions_with_oac" },
      "why": "Enumerate CloudFront distributions — CDN/edge entry points and their origins. Each origin's Origin Access Control (OAC) is resolved and embedded in configuration.",
      "items_path": "[]",
      "natural_key": "ARN",
      "fields": {
        "name": "DomainName",
        "distribution_arn": "ARN",
        "domain_name": "DomainName",
        "status": "Status",
        "enabled": "Enabled"
      },
      "tags": {
        "source": "service",
        "op": "ListTagsForResource",
        "params": {
          "Resource": { "from": "ARN" }
        },
        "path": "Tags.Items",
        "shape": "list_kv",
        "why": "Resource tags — CloudFront Tag Editor/Resource Groups unsupported; side-quest."
      },
      "edges": [
        {
          "value_path": "Origins.Items[].DomainName",
          "target_type": "aws_s3_bucket",
          "key_kind": "arn",
          "edge_type": "RETRIEVES_CONTENT_FROM",
          "direction": "outbound",
          "transform": "s3_bucket_name_from_origin_domain"
        },
        {
          "value_path": "ViewerCertificate.ACMCertificateArn",
          "target_type": "aws_acm_certificate",
          "key_kind": "arn",
          "edge_type": "RETRIEVES_CERT_FROM",
          "direction": "outbound"
        }
      ]
    },
    {
      "entity_type": "aws_s3_bucket",
      "service": "s3",
      "scope": "global",
      "source": { "custom_fn": "s3_buckets_hydrated" },
      "why": "Enumerate S3 buckets — object storage; content origins, state, and data stores.",
      "items_path": "[]",
      "natural_key": "BucketArn",
      "fields": {
        "name": "Name",
        "bucket_arn": "BucketArn"
      },
      "tags": {
        "source": "rgta",
        "resource_type_filter": "s3",
        "arn_from": "BucketArn",
        "why": "Resource tags — RGTA s3 (buckets-only, which is our target)."
      },
      "hydrate": [
        {
          "key": "bucket_location",
          "op": "GetBucketLocation",
          "why": "Bucket region — data-residency and region-scoped control posture."
        },
        {
          "key": "public_access_block",
          "op": "GetPublicAccessBlock",
          "why": "Account/bucket public-access block — a core KSI exposure control."
        },
        {
          "key": "encryption",
          "op": "GetBucketEncryption",
          "why": "Default server-side encryption — KSI data-at-rest control."
        },
        {
          "key": "versioning",
          "op": "GetBucketVersioning",
          "why": "Object versioning state — KSI data-integrity / recovery control."
        },
        {
          "key": "policy_status",
          "op": "GetBucketPolicyStatus",
          "why": "Whether the bucket policy makes it public — KSI exposure control."
        },
        {
          "key": "policy",
          "op": "GetBucketPolicy",
          "why": "Bucket resource policy document — the grant side of access (e.g. the CloudFront service principal authorized for OAC origin reads). NoSuchBucketPolicy classifies as absent."
        }
      ],
      "edges": []
    },
    {
      "entity_type": "aws_route53_zone",
      "service": "route53",
      "scope": "global",
      "source": { "custom_fn": "route53_zones_with_alias_targets" },
      "why": "Enumerate Route 53 hosted zones with resolved alias targets — DNS topology and routing.",
      "items_path": "[]",
      "natural_key": "Id",
      "fields": {
        "name": "Name",
        "hosted_zone_id": "Id",
        "record_count": "ResourceRecordSetCount",
        "private_zone": "Config.PrivateZone"
      },
      "tags": {
        "source": "service",
        "op": "ListTagsForResource",
        "params": {
          "ResourceType": { "literal": "hostedzone" },
          "ResourceId": { "from": "_zone_resource_id" }
        },
        "path": "ResourceTagSet.Tags",
        "shape": "list_kv",
        "why": "Resource tags — RGTA excludes Route 53 zones; per-service side-quest. ResourceId is the bare zone-id segment; the custom_fn adds it as _zone_resource_id."
      },
      "edges": [
        {
          "value_path": "alias_cloudfront_arns[]",
          "target_type": "aws_cloudfront_distribution",
          "key_kind": "arn",
          "edge_type": "ROUTES_TRAFFIC",
          "direction": "outbound"
        }
      ]
    },
    {
      "entity_type": "aws_dynamodb_table",
      "service": "dynamodb",
      "scope": "regional",
      "source": { "custom_fn": "dynamodb_tables_described" },
      "why": "Enumerate DynamoDB tables — table-shaped NoSQL state stores; e.g. Terraform's tfstate-lock table.",
      "items_path": "[]",
      "natural_key": "TableArn",
      "fields": {
        "name": "TableName",
        "table_arn": "TableArn",
        "status": "TableStatus",
        "billing_mode": "BillingModeSummary.BillingMode"
      },
      "tags": {
        "source": "rgta",
        "resource_type_filter": "dynamodb:table",
        "why": "Resource tags — RGTA covers DynamoDB tables."
      },
      "edges": []
    },
    {
      "entity_type": "aws_iam_oidc_provider",
      "service": "iam",
      "scope": "global",
      "source": { "custom_fn": "iam_oidc_providers_described" },
      "why": "Enumerate IAM OIDC identity providers — federated machine identities (e.g. GitHub Actions) that trust this account.",
      "items_path": "[]",
      "natural_key": "ProviderArn",
      "fields": {
        "name": "Url",
        "provider_arn": "ProviderArn",
        "url": "Url",
        "client_ids": "ClientIDList",
        "thumbprints": "ThumbprintList"
      },
      "tags": {
        "source": "service",
        "op": "ListOpenIDConnectProviderTags",
        "params": {
          "OpenIDConnectProviderArn": { "from": "ProviderArn" }
        },
        "path": "Tags",
        "shape": "list_kv",
        "why": "Resource tags — RGTA excludes IAM resources; per-service side-quest."
      },
      "edges": []
    }
  ]
}
