# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored (may hold ARNs).

aws_region   = "us-east-1"
github_owner = "notgeorge"
github_repo  = "tap"

# First apply: leave empty, let Terraform create the connection, then AUTHORIZE it in
# the console and re-apply (or apply once and authorize — builds just wait until then).
# Subsequent: paste the authorized connection ARN to reuse it.
codeconnection_arn = ""

# Product lines to stand up. `needs_plugin_pull` grants that line GetSecretValue on the
# plugin-pull secret (lines that git-install private plugins). Post-eviction both lanes are
# git-sourced (the monorepo plugin copies are gone), so both set it true.
product_lines = {
  test_all = { profile = "test_all", needs_plugin_pull = true }
  samsite  = { profile = "samsite", needs_plugin_pull = true }
}

# Capability axis:
bedrock_enabled      = true
sts_assume_role_arns = [] # e.g. ["arn:aws:iam::<acct>:role/tap-aws-core-test"]

# The plugin-pull secret SHELL name (value set out-of-band via put-secret-value; never
# managed by Terraform). Empty "" disables the secret + grants for a monorepo-only setup.
plugin_pull_secret_name = "tap-ci/github-plugins-ro"
