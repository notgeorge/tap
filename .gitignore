# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
dist/
build/

# Virtual environment (managed by UV)
.venv/
.venv-host/

# UV lock file is committed (reproducible builds)
# but the cache is not
.uv-cache/

# Django
*.sqlite3
staticfiles/
media/

# Environment / secrets
# .env is checked in with defaults so `docker compose up` works out of the box.
# .env.local is the per-worktree override layer for multi-session dev — see spec-dev-multisession.md.
.env.local
.env.*.local
# Per-session admin credentials (auto-generated by spawn-session.sh, scoped to one worktree).
# Plaintext on disk — see req-dev-multisession-admin-bootstrap.
.dev-credentials
# tap-cares mounted secret files. Secret fixtures/templates must use a
# non-matching suffix such as .secret.example.json.
*.secret.json
# Host-side bind-mount target backing the tap-cares Compose secrets mount
# (./tap_secrets:/run/tap-secrets:ro). May be a real directory OR a symlink
# to a shared host dir ($HOME/tap-secrets) when worktrees share one secret
# set. No trailing slash so the pattern matches the symlink too — a
# directory-only pattern leaves the symlink showing as untracked.
# Operator-managed at runtime; nothing in the repo, nothing in tests.
# See tap_cares/specs/spec-tap-cares-secrets.md.
/tap_secrets

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docker
# Note: docker-compose.yml IS committed (it's dev config, not secrets)

# Vendored third-party assets (AWS icon pack, etc.) — stashed locally, raided for
# individually relicensed icons copied into plugin static dirs.
vendor/
# Carve-out: plugin-internal vendor dirs ARE committed (e.g. roscale ships the
# OSCAL 1.1.2 JSON Schema bundle per req-roscale-vendor). Plugin specs are the
# authority on what their vendor/ contains; the generic raid pattern doesn't apply.
!plugins/*/vendor/
!plugins/*/vendor/**

# In-flight debugging screenshots. Convention: save ad-hoc screenshots to
# screenshots/ so they don't clutter the repo root. Contents are transient.
screenshots/
# Playwright MCP cache directory (auto-generated page snapshots).
.playwright-mcp/
