// TAP Traversal Language Grammar
// Authoritative syntax specification for spec-grid-traversal-execution.md
// Parser: lark earley, ambiguity=resolve
//
// Convention: terminals prefixed with _ are discarded from parse-tree children.
// This keeps transformer methods clean — they receive only data tokens, not keywords.

start: clause+

clause: match_clause
      | where_clause
      | return_clause
      | not_exists_clause
      | order_by_clause
      | limit_clause

// ---------------------------------------------------------------------------
// NOT EXISTS subquery (correlated anti-join)
// ---------------------------------------------------------------------------

not_exists_clause: _NOT_KW _EXISTS_KW "{" match_clause where_clause? "}"

// ---------------------------------------------------------------------------
// MATCH
// ---------------------------------------------------------------------------

match_clause: _MATCH_KW path_var? pattern ("," pattern)*

path_var: NAME "="

pattern: node_pattern (edge_pattern node_pattern)*

node_pattern: "(" node_body ")"
node_body: node_body_var? node_body_label? inline_props?
node_body_var:   NAME
node_body_label: ":" NAME

edge_pattern: outbound_edge
            | inbound_edge
            | undirected_edge

outbound_edge:   "-[" edge_body "]->"
inbound_edge:    "<-[" edge_body "]-"
undirected_edge: "-[" edge_body "]-"

edge_body: edge_body_var? edge_body_type? hop_range? inline_props?
edge_body_var:  NAME
edge_body_type: ":" NAME
hop_range: "*" INT ".." INT

inline_props: "{" prop_pair ("," prop_pair)* "}"
prop_pair: NAME ":" value

// ---------------------------------------------------------------------------
// WHERE
// ---------------------------------------------------------------------------

where_clause: _WHERE_KW predicate

// Precedence (lowest to highest): OR < AND < NOT < atom.
// Earley with ambiguity=resolve handles left-recursive OR/AND.
predicate: predicate _OR_KW predicate    -> or_pred
         | predicate _AND_KW predicate   -> and_pred
         | _NOT_KW predicate             -> not_pred
         | "(" predicate ")"             -> paren_pred
         | comparison

comparison: field_path COMPARE_OP value

field_path: NAME field_step*
field_step: "." NAME               -> dot_step
          | "[" ESCAPED_STRING "]" -> key_step
          | "[" INT "]"            -> index_step
          | "[" STAR "]"           -> wildcard_step

STAR: "*"
COMPARE_OP: "=" | "!=" | "<=" | ">=" | "<" | ">"

// ---------------------------------------------------------------------------
// RETURN
// ---------------------------------------------------------------------------

return_clause: _RETURN_KW return_item ("," return_item)*

return_item: aggregate_call _AS_KW NAME   -> aggregate_item
           | field_path (_AS_KW NAME)?    -> field_item

aggregate_call: _COUNT_KW "(" field_path ")"

// ---------------------------------------------------------------------------
// ORDER BY / LIMIT
// ---------------------------------------------------------------------------
//
// Both operate on row-projection results only (an explicit RETURN that names
// field paths and/or aggregates). An order_item names a RETURN output by its
// alias (or, for an unaliased field projection, its last dot-step name).

order_by_clause: _ORDER_KW _BY_KW order_item ("," order_item)*
order_item: NAME order_dir?
order_dir: _ASC_KW  -> asc
         | _DESC_KW -> desc

limit_clause: _LIMIT_KW INT

// ---------------------------------------------------------------------------
// Values
// ---------------------------------------------------------------------------

value: ESCAPED_STRING  -> string_val
     | NUMBER          -> number_val
     | param_ref
     | /true/i         -> true_val
     | /false/i        -> false_val
     | /null/i         -> null_val

param_ref: "$" NAME

// ---------------------------------------------------------------------------
// Keywords — underscore prefix causes lark to discard them from tree children
// ---------------------------------------------------------------------------

_MATCH_KW:  /MATCH/i
_WHERE_KW:  /WHERE/i
_RETURN_KW: /RETURN/i
_AND_KW:    /AND/i
_OR_KW:     /OR/i
_NOT_KW:    /NOT/i
_AS_KW:     /AS/i
_EXISTS_KW: /EXISTS/i
_COUNT_KW:  /COUNT/i
_ORDER_KW:  /ORDER/i
_BY_KW:     /BY/i
_ASC_KW:    /ASC/i
_DESC_KW:   /DESC/i
_LIMIT_KW:  /LIMIT/i

// ---------------------------------------------------------------------------
// Terminals
// ---------------------------------------------------------------------------

NAME:   /[a-zA-Z_][a-zA-Z0-9_]*/
INT:    /[0-9]+/
NUMBER: /-?[0-9]+(\.[0-9]+)?/

%import common.ESCAPED_STRING
%import common.WS
%ignore WS
